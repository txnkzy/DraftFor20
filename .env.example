# ── Supabase → Project Settings → API ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://jwnlmvjzeodfmngnhadq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The service role key is NOT used by this app. Do not add it here.

# Your public origin. Used by the sitemap, OG tags, the watermark on the
# export card, and as the return address for Stripe Checkout.
NEXT_PUBLIC_SITE_URL=https://draftfor20.app

# ── Payments — ALL OPTIONAL ───────────────────────────────────────────────
# Leave every one of these empty and the site is fully functional: premium
# features stay locked, the upgrade panel says "payments coming soon", and
# nothing 500s. Premium is granted by hand until these are set (see the
# README's Premium section). Server-side only; never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEEK_PRICE_ID=
STRIPE_PASS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# How the webhook writes to Postgres without a service-role key. Generated by
# 0019_billing.sql:
#   select value from public.df20_config where key = 'billing_write_secret';
DF20_BILLING_SECRET=

# ── Wikipedia category cache writes (existing) ────────────────────────────
# select value from public.df20_config where key = 'wiki_write_secret';
WIKI_WRITE_SECRET=

# ── Cloudflare Turnstile — OPTIONAL ───────────────────────────────────────
# With both unset, the widget does not render, the server records the
# outcome as "skipped", and signup proceeds. An anti-bot key that has not
# been set up must never be the reason a real person cannot make an account.
#
# Get both free at: Cloudflare dashboard → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Admin changelog — OPTIONAL ────────────────────────────────────────────
# Without it the admin changelog lists in-app admin actions only and says so.
# Fine-grained personal access token, Contents: Read-only, this repo only.
# github.com/settings/tokens?type=beta
GITHUB_TOKEN=
GITHUB_REPO=txnkzy/DraftFor20

# ── Quick Play opponent — ALL OPTIONAL ────────────────────────────────────
# With NO key set, the bot plays from df20_bot_heuristic() in Postgres: free,
# instant, never rate limited. A key upgrades its taste, nothing else — every
# move is still executed through bot_act -> offer_decide/place_bid/pass_turn
# and re-validated by the same money rules a human goes through.
#
# Both free tiers are ~1,000 requests/day and a draft is ~25 decisions, so
# they are a garnish at current volume, not a foundation. The heuristic
# catches every 429, timeout and unparseable reply without the player
# noticing. Tried in the order listed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
